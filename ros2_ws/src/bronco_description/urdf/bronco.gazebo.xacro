<?xml version="1.0"?>
<!--
  Gazebo-only parts of the Bronco model.

  Anything inside a <gazebo> tag is ignored by ROS tools (robot_state_publisher,
  RViz) and only used when Gazebo loads the model. Keeping it in its own file
  makes it clear what's "the real robot" and what's "simulation glue".

  Three kinds of things live here:
    1. Physics settings (tire friction)
    2. Plugins ("systems"): code that moves joints and publishes data
    3. Simulated sensors: LiDAR, camera, IMU

  Gazebo talks on its OWN topics (gz transport), not ROS topics.
  ros_gz_bridge (configured in bronco_gazebo/config/bridge.yaml) copies
  messages between the two worlds.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====================== 1. Tire friction ======================
       mu1/mu2 = friction coefficients in the two directions of the contact.
       ~1.0 is rubber on concrete. Too low and the car slides like it's on ice. -->
  <xacro:macro name="tire_friction" params="link">
    <gazebo reference="${link}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:tire_friction link="rear_left_wheel"/>
  <xacro:tire_friction link="rear_right_wheel"/>
  <xacro:tire_friction link="front_left_wheel"/>
  <xacro:tire_friction link="front_right_wheel"/>

  <!-- ====================== 2. Plugins ====================== -->
  <gazebo>
    <!-- AckermannSteering: takes a velocity command (Twist: forward speed +
         turn rate), computes the correct steering angle for each front wheel
         (the inner wheel turns more than the outer: that's "Ackermann"
         geometry) and spins the rear wheels. It also integrates wheel motion
         into odometry (/odom) and publishes the odom -> base_link transform.
         On the real car, your ESP32 + motor controller will do this job. -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_separation>${track}</wheel_separation>
      <kingpin_width>${track}</kingpin_width>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <steering_limit>${steering_limit}</steering_limit>
      <min_velocity>-3</min_velocity>
      <max_velocity>3</max_velocity>
      <min_acceleration>-3</min_acceleration>
      <max_acceleration>3</max_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>

    <!-- JointStatePublisher: publishes every joint's angle (wheels spinning,
         steering angle). robot_state_publisher turns these into TF frames so
         RViz shows the wheels turning. On the real robot, encoders + the
         steering servo command would provide this. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ====================== 3. Sensors ======================
       Each sensor is attached to the link that marks its position.
       <gz_frame_id> sets the frame name written in each message's header, so
       the data lines up with our URDF frames in RViz. -->

  <!-- 2D LiDAR: 360 rays, one per degree, 10 scans/sec, 0.12-12 m range.
       Roughly an RPLIDAR A1/A2. "gpu_lidar" uses the graphics card to
       ray-trace the scene. -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <!-- Real sensors are noisy; simulating it keeps your code honest -->
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Camera: 640x480 at 30 fps, ~70 deg field of view.
       Also publishes /camera/camera_info (lens parameters) automatically. -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>/camera/image</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.22</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- IMU: accelerometer + gyroscope at 100 Hz -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

</robot>
