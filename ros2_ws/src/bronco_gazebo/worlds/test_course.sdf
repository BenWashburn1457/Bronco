<?xml version="1.0"?>
<!--
  A simple test world: a 10 m x 10 m walled area with a few obstacles,
  enough for the LiDAR to see walls and the camera to see colored objects.

  Worlds are written in SDF (Simulation Description Format), Gazebo's native
  format. SDF is more capable than URDF (it can describe whole worlds, lights
  and closed kinematic loops); our URDF gets converted to SDF when spawned.

  Everything here is built from simple shapes, so it loads offline with no
  downloads. Add your own obstacles by copying a <model> block.
-->
<sdf version="1.9">
  <world name="test_course">

    <!-- Physics step: 1 ms. real_time_factor 1 = try to run at real-world speed -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- World "systems": the parts of Gazebo that are switched on for this world -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Runs the rendering sensors (LiDAR, camera). ogre2 = the 3D render engine. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Runs IMU sensors (they don't need rendering, so it's a separate system) -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Four walls. "static" = fixed in place, physics never moves them. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.1 0.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.7 1</ambient><diffuse>0.8 0.8 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10 0.1 0.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.7 1</ambient><diffuse>0.8 0.8 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 10 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10 0.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.7 1</ambient><diffuse>0.8 0.8 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 10 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10 0.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.7 1</ambient><diffuse>0.8 0.8 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Obstacles -->
    <model name="red_box">
      <static>true</static>
      <pose>2 1.5 0.2 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.4</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="green_cylinder">
      <static>true</static>
      <pose>3 -2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blue_box">
      <static>true</static>
      <pose>-2 -3 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 0.3 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.3 0.3</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="yellow_cylinder">
      <static>true</static>
      <pose>-2.5 2.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
