<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bronco_teleop</name>
  <version>0.0.0</version>
  <description>Keyboard (WASD / arrow keys) driving for Bronco, car-style.</description>
  <maintainer email="benrobertwashburn@gmail.com">ben</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- Qt for the drive window (ROS's wrapper around PyQt) -->
  <exec_depend>python_qt_binding</exec_depend>

  <export>
    <!-- ament_python = a pure-Python package (built with setup.py, not CMake) -->
    <build_type>ament_python</build_type>
  </export>
</package>
